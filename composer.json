{
	"name": "pixelpair/pixelpair",
	"description": "An original WordPress pixel and conversion API manager.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/woocommerce-stubs": "^11.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^1.12",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"PixelPair\\": "src/"
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=2G",
		"test": "@php scripts/test.php",
		"test:local": "phpunit"
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"homepage": "https://github.com/arifhasnat3po",
	"authors": [
		{
			"name": "Arif Hasnat",
			"email": "63786513+arifhasnat3po@users.noreply.github.com",
			"homepage": "https://github.com/arifhasnat3po"
		}
	]
}
