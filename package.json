{
	"name": "pixelpair",
	"version": "0.9.4",
	"private": true,
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=24.18.0",
		"npm": ">=11.16.0"
	},
	"scripts": {
		"build": "wp-scripts build",
		"check:front-size": "node scripts/check-front-size.mjs",
		"check:admin-size": "node scripts/check-admin-size.mjs",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js assets/src tests/js tests/e2e scripts/*.mjs *.js",
		"lint:css": "wp-scripts lint-style assets/src/**/*.scss",
		"format": "prettier --write assets/src tests/js tests/e2e scripts *.js *.json *.md docs .github",
		"format:check": "prettier --check assets/src tests/js tests/e2e scripts *.js *.json *.md docs .github",
		"test:unit": "wp-scripts test-unit-jest",
		"test:e2e": "playwright test",
		"wp-env": "wp-env",
		"build:release": "node scripts/build-release.mjs",
		"test:release": "node scripts/check-release.mjs",
		"brand": "node scripts/build-brand.mjs",
		"check:brand": "node scripts/check-brand.mjs",
		"build:docs": "node scripts/build-docs.mjs"
	},
	"dependencies": {
		"@wordpress/a11y": "4.56.0",
		"@wordpress/api-fetch": "7.56.0",
		"@wordpress/components": "41.0.0",
		"@wordpress/data": "10.56.0",
		"@wordpress/element": "8.8.0",
		"@wordpress/i18n": "6.29.0"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@resvg/resvg-js": "2.6.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@wordpress/babel-preset-default": "^8.55.0",
		"@wordpress/base-styles": "13.2.0",
		"@wordpress/env": "11.16.0",
		"@wordpress/eslint-plugin": "^27.0.0",
		"@wordpress/jest-preset-default": "^14.2.0",
		"@wordpress/scripts": "36.0.0",
		"adm-zip": "0.6.1",
		"axe-core": "4.13.0",
		"babel-jest": "^30.5.0",
		"eslint-plugin-jest": "^29.16.6",
		"jest": "^30.5.0",
		"jest-environment-jsdom": "^30.5.0",
		"opentype.js": "2.0.0",
		"prettier": "3.9.6",
		"svgo": "4.1.0",
		"markdown-it": "14.3.2",
		"jsdom": "26.1.0"
	},
	"jest": {
		"preset": "@wordpress/jest-preset-default",
		"testMatch": [
			"<rootDir>/tests/js/**/*.test.js"
		],
		"setupFilesAfterEnv": [
			"<rootDir>/tests/js/setup.js"
		],
		"transform": {
			"\\.[cm]?[jt]sx?$": [
				"babel-jest",
				{
					"presets": [
						"@wordpress/babel-preset-default"
					]
				}
			]
		},
		"transformIgnorePatterns": [
			"/node_modules/(?!uuid/|@wordpress/theme/)"
		]
	},
	"homepage": "https://github.com/arifhasnat3po",
	"author": {
		"name": "Arif Hasnat",
		"email": "63786513+arifhasnat3po@users.noreply.github.com",
		"url": "https://github.com/arifhasnat3po"
	}
}
